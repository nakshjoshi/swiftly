DATABASE_URL=

# REQUIRED — the app refuses to start without these. Each must be >= 32 chars and ACCESS/REFRESH must differ.
# Generate one with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECRET=

# Cookies. `bun run dev` sets NODE_ENV=development itself (host-only, SameSite=Lax, non-Secure cookies).
# Anything else is treated as production: Secure + SameSite=None, and COOKIE_DOMAIN is REQUIRED.
# Leave COOKIE_DOMAIN unset locally — a cookie for a real domain is rejected on localhost.
# COOKIE_DOMAIN=.swiftly.nakshjoshi.in

ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Passkeys (WebAuthn): bare domain for the relying-party ID, full origin for the frontend
DOMAIN_NAME=localhost
FRONTEND_URL=http://localhost:3000

# URL of the standalone latex-service (Docker container in prod, localhost:4000 in local)
LATEX_SERVICE_URL=http://localhost:4000
