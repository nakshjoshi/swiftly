DATABASE_URL=

# REQUIRED — the app refuses to start without these. Each must be >= 32 chars and ACCESS/REFRESH must differ.
# Generate one with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECRET=

# Cookies. `bun run dev` sets NODE_ENV=development itself (host-only, SameSite=Lax, non-Secure cookies).
# Anything else is treated as production: Secure + SameSite=None, and COOKIE_DOMAIN is REQUIRED.
# Leave COOKIE_DOMAIN unset locally — a cookie for a real domain is rejected on localhost.
# COOKIE_DOMAIN=.swiftly.nakshjoshi.in

# Access token: short (max 1h) — it cannot be revoked, so logout only bites once it expires
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Browser origins allowed to call the API (comma-separated). Defaults: http://localhost:3000 in dev,
# https://swiftly.nakshjoshi.in otherwise. Add a staging frontend here instead of editing code.
# CORS_ORIGINS=https://swiftly.nakshjoshi.in,https://staging.swiftly.nakshjoshi.in

# Max Postgres connections per backend instance (default 10)
# DB_POOL_MAX=10

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Passkeys (WebAuthn): bare domain for the relying-party ID, full origin for the frontend
DOMAIN_NAME=localhost
FRONTEND_URL=http://localhost:3000

# URL of the standalone latex-service (Docker container in prod, localhost:4000 in local)
LATEX_SERVICE_URL=http://localhost:4000
